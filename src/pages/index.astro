---
import '../styles/global.css';
import { site, hero, pillars, brands, services, contact, mailto, videoOverrides,
         platforms, crossPlatformTotal, credentials, audienceNote, caseStudy } from '../data/content';
import { readSnapshot } from '../lib/store';
import { DATA_ACCESS_EXPIRES } from '../lib/instagram';

const { data, source } = await readSnapshot();

const n = (v: number) => v.toLocaleString('en-US');
const compact = (v: number) =>
  v >= 1000 ? `${(v / 1000).toFixed(v >= 10_000 ? 0 : 1)}K` : String(v);

const synced = new Date(data.syncedAt).toLocaleDateString('en-US', {
  month: 'short', day: 'numeric', year: 'numeric',
});

// Gender labels come back as F / M / U.
const genderLabel: Record<string, string> = { F: 'Women', M: 'Men', U: 'Unspecified' };
const genderTotal = data.gender.reduce((s, g) => s + g.value, 0);
const women = data.gender.find((g) => g.label === 'F')?.value ?? 0;

const ageTotal = data.age.reduce((s, a) => s + a.value, 0);
// Drop buckets under 1% — they add rows without adding information, and the
// 13-17 bucket in particular is noise a brand should not be reading into.
const ageRows = data.age.filter((a) => a.value / ageTotal >= 0.01);
const ageMax = Math.max(...ageRows.map((a) => a.value), 1);
const cityMax = Math.max(...data.cities.map((c) => c.value), 1);
const usShare = (() => {
  const total = data.countries.reduce((s, c) => s + c.value, 0);
  const us = data.countries.find((c) => c.label === 'US')?.value ?? 0;
  return total ? Math.round((us / total) * 100) : 0;
})();

// Best recent post, by reach — the strongest single piece of evidence here.
const best = [...data.media].sort((a, b) => b.reach - a.reach)[0];
const bestReachVsFollowers = best && data.followers
  ? Math.round((best.reach / data.followers) * 100)
  : 0;

const topCities = data.cities.slice(0, 6);
// A media kit leads with the best work, not the most recent.
const EIGHTEEN_MONTHS = 18 * 30 * 86_400_000;
const work = [...data.media]
  // Windowed: pre-2023 posts carry incoherent legacy metrics (huge view counts
  // against tiny reach) that a brand would rightly question.
  .filter((m) => m.reach > 0 && Date.now() - new Date(m.timestamp).getTime() < EIGHTEEN_MONTHS)
  .sort((a, b) => b.reach - a.reach)
  .slice(0, 8)
  // A file you host wins over Meta's URL: it never expires and always exists.
  .map((m) => ({ ...m, clip: videoOverrides[m.id] ?? m.videoUrl }));

const autoplayCount = work.filter((m) => m.clip).length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={`https://${site.domain}/`} />
  </head>

  <body>
    <header class="masthead">
      <div class="wrap">
        <a class="wordmark" href="#top">TIALEEAPPROVED</a>
        <span class="sync">
          <span class="dot" aria-hidden="true"></span>
          {source === 'live' ? 'LIVE' : 'SNAPSHOT'} · {synced.toUpperCase()}
        </span>
        <nav class="nav">
          <a href="#audience">Audience</a>
          <a href="#pillars">Pillars</a>
          <a href="#work">Work</a>
          <a href="#receipts">Receipts</a>
          <a href="#contact">Contact</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <!-- 01 HERO ------------------------------------------------------- -->
      <section class="hero">
        <div class="wrap">
          <div class="label">{hero.eyebrow}</div>
          <h1>{hero.headline}</h1>
          <p>{hero.sub}</p>

          <div class="headline-stats">
            <div class="stat">
              <div class="v">{compact(crossPlatformTotal)}</div>
              <div class="k">Across platforms</div>
              <div class="note">TikTok · Instagram · LinkedIn · YouTube</div>
            </div>
            <div class="stat">
              <div class="v">{data.engagementRate}%</div>
              <div class="k">Engagement rate</div>
              <div class="note">Interactions ÷ reach, verified</div>
            </div>
            <div class="stat">
              <div class="v">{bestReachVsFollowers.toLocaleString()}%</div>
              <div class="k">Best post reach</div>
              <div class="note">As a share of follower count</div>
            </div>
            <div class="stat">
              <div class="v">{usShare}%</div>
              <div class="k">United States</div>
              <div class="note">{compact(data.reach28)} reached in 28 days</div>
            </div>
          </div>

          <div class="platforms">
            {platforms.map((p) => (
              <a class="plat" href={p.url ?? '#'} target={p.url ? '_blank' : undefined} rel="noopener noreferrer">
                <span class="pn">{p.name}</span>
                <span class="pv">{compact(p.followers)}</span>
                <span class="pl">{p.live ? 'LIVE' : 'SELF-REPORTED'}</span>
              </a>
            ))}
          </div>

          <ul class="creds">
            {credentials.map((c) => (
              <li><b>{c.label}</b> — {c.note}</li>
            ))}
          </ul>
        </div>
      </section>

      <!-- 02 AUDIENCE --------------------------------------------------- -->
      <section class="section" id="audience">
        <div class="wrap">
          <div class="section-head">
            <span class="section-num">02</span>
            <span class="section-title">Audience</span>
            <span class="rule"></span>
            <span class="section-tag">Instagram Graph API · synced {synced}</span>
          </div>

          <div class="panels">
            <div class="panel">
              <h3 class="label">Age</h3>
              {ageRows.map((a) => (
                <div class="bar-row">
                  <span class="bl">{a.label}</span>
                  <span class="track"><span class="fill" style={`width:${(a.value / ageMax) * 100}%`}></span></span>
                  <span class="bv">{Math.round((a.value / ageTotal) * 100)}%</span>
                </div>
              ))}
            </div>

            <div class="panel">
              <h3 class="label">Top cities</h3>
              {topCities.map((c) => (
                <div class="bar-row">
                  <span class="bl" style="width:auto;flex:1">{c.label}</span>
                  <span class="track" style="flex:0 0 70px"><span class="fill" style={`width:${(c.value / cityMax) * 100}%`}></span></span>
                  <span class="bv">{n(c.value)}</span>
                </div>
              ))}
            </div>

            <div class="panel">
              <h3 class="label">Behaviour · 28 days</h3>
              <div class="bar-row"><span class="bl" style="width:auto;flex:1">Saves</span><span class="bv">{n(data.saves28)}</span></div>
              <div class="bar-row"><span class="bl" style="width:auto;flex:1">Shares</span><span class="bv">{n(data.shares28)}</span></div>
              <div class="bar-row"><span class="bl" style="width:auto;flex:1">Interactions</span><span class="bv">{n(data.interactions28)}</span></div>
              <div class="bar-row"><span class="bl" style="width:auto;flex:1">Profile views</span><span class="bv">{n(data.profileViews28)}</span></div>
              <h3 class="label" style="margin-top:22px">Gender</h3>
              {data.gender.map((g) => (
                <div class="bar-row">
                  <span class="bl" style="width:auto;flex:1">{genderLabel[g.label] ?? g.label}</span>
                  <span class="bv">{Math.round((g.value / genderTotal) * 100)}%</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- 03 PILLARS ---------------------------------------------------- -->
      <section class="section" id="pillars">
        <div class="wrap">
          <div class="section-head">
            <span class="section-num">03</span>
            <span class="section-title">Pillars</span>
            <span class="rule"></span>
            <span class="section-tag">Three lanes</span>
          </div>
          <div class="pillars">
            {pillars.map((p) => (
              <div class="pillar">
                <div class="ch label">CH {p.channel} · {p.name}</div>
                <h3>{p.headline}</h3>
                <p>{p.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 04 WORK ------------------------------------------------------- -->
      <section class="section" id="work">
        <div class="wrap">
          <div class="section-head">
            <span class="section-num">04</span>
            <span class="section-title">Work</span>
            <span class="rule"></span>
            <span class="section-tag">{autoplayCount > 0 ? `${autoplayCount} of ${work.length} autoplaying` : "Numbers pulled per post"}</span>
          </div>
          <div class="grid">
            {work.map((m) => (
              <a class="card" href={m.permalink} target="_blank" rel="noopener noreferrer">
                <div class="media">
                  {m.clip ? (
                    <video
                      src={m.clip}
                      poster={m.thumbnail ?? undefined}
                      muted
                      loop
                      playsinline
                      autoplay
                      preload="none"
                      tabindex="-1"
                      data-clip
                    />
                  ) : (
                    m.thumbnail && (
                      <img src={m.thumbnail} alt="" loading="lazy" decoding="async" onerror="this.style.display='none'" />
                    )
                  )}
                </div>
                <div class="meta">
                  <div><b>{compact(m.views)}</b><span>Views</span></div>
                  <div><b>{n(m.saves)}</b><span>Saves</span></div>
                  <div><b>{n(m.shares)}</b><span>Shares</span></div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- 05 RECEIPTS --------------------------------------------------- -->
      <section class="section" id="receipts">
        <div class="wrap">
          <div class="section-head">
            <span class="section-num">05</span>
            <span class="section-title">Receipts</span>
            <span class="rule"></span>
            <span class="section-tag">{audienceNote}</span>
          </div>
          <div class="casestudy">
            <div class="cs-body">
              <div class="label">{caseStudy.label}</div>
              <h3>{caseStudy.title}</h3>
              <p class="stand">{caseStudy.standfirst}</p>
              <p>{caseStudy.body}</p>
              <p class="kicker">{caseStudy.kicker}</p>
            </div>
            <div class="cs-stats">
              {caseStudy.stats.map((s) => (
                <div class="cs-stat"><b>{s.value}</b><span>{s.label}</span></div>
              ))}
            </div>
          </div>

          <div class="label" style="margin-bottom:14px">Partnered with</div>
          <div class="brandrow">
            {brands.map((b) => (
              <span class="brandchip">{b.name}{b.work && <em> · {b.work}</em>}</span>
            ))}
          </div>
        </div>
      </section>

      <!-- 06 CONTACT ---------------------------------------------------- -->
      <section class="section contact" id="contact">
        <div class="wrap">
          <h2>{contact.headline}</h2>
          <p>{contact.body}</p>
          <div class="services">
            {services.map((s) => (
              <span class="chip">{s.name} <span>· {s.note}</span></span>
            ))}
          </div>
          <a class="cta" href={mailto()}>{site.email} →</a>
        </div>
      </section>

      <div class="wrap">
        <div class="foot">
          <span>{site.name} · {site.location}</span>
          <a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
          <span class="sp">
            Figures from the Instagram Graph API · synced {synced}
            {source === 'snapshot' && ' · fallback'}
          </span>
        </div>
      </div>
    </main>

    <!-- Data access for the Meta app expires {DATA_ACCESS_EXPIRES}; re-authorize before then. -->

    <script>
      /*
       * Play clips only while they are on screen.
       *
       * `autoplay` alone starts every video at once — eight simultaneous streams
       * is a bandwidth bill and a stuttering phone. This pauses anything scrolled
       * out of view and resumes it on the way back.
       *
       * Anyone who has asked their OS to reduce motion gets the poster frame and
       * nothing else.
       */
      const clips = document.querySelectorAll('video[data-clip]');
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (still) {
        clips.forEach((v) => { v.autoplay = false; v.removeAttribute('autoplay'); v.pause(); });
      } else if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              const v = e.target;
              if (e.isIntersecting) {
                // play() rejects if the browser blocks it (iOS Low Power Mode,
                // data saver). The poster frame is the fallback, so ignore it.
                v.play().catch(() => {});
              } else {
                v.pause();
              }
            });
          },
          { rootMargin: '100px', threshold: 0.25 }
        );
        clips.forEach((v) => io.observe(v));
      }
    </script>
  </body>
</html>
